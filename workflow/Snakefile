"""
AFdb domain extraction workflow.
================================

Root Snakefile: configuration roots, shared result path constants, stage
includes, and the default target.

Rules live in ``workflow/rules/<nn>_<stage>.smk``, one file per pipeline stage:
AFdb extraction, UniProt refresh, comparison, registry, curated chain, then the
legacy per-dataset branch.

Input
-----
- ``config/config.yaml`` and the pinned resources it points at.

Output
------
- ``results/01_afdb/03_afdb_entries.tsv``,
  ``results/04_registry/01_gene_structure_registry.tsv``,
  ``results/04_registry/03_registry_stats.tsv``, and
  ``results/10_segments.tsv``.

Usage
-----
    snakemake -n
    snakemake --cores 16 --use-conda
"""

from pathlib import Path

WORKFLOW_DIR = Path(workflow.basedir).resolve()
PROJECT_ROOT = WORKFLOW_DIR.parent
CONFIG_PATH = PROJECT_ROOT / "config" / "config.yaml"
RESULTS = PROJECT_ROOT / "results"
DATA = PROJECT_ROOT / "data"
RESOURCES = PROJECT_ROOT / "resources"
CLI = PROJECT_ROOT / "scripts" / "afdb_domains.py"
COMPARE_SCRIPT = PROJECT_ROOT / "scripts" / "compare_afdb_pombase.py"
CORE_ENV = str(WORKFLOW_DIR / "envs" / "core.yaml")

configfile: str(CONFIG_PATH)

CACHE_ROOT = Path(config["paths"]["cache_root"])
REFERENCE_ROOT = Path(config["paths"]["reference_root"])
LEGACY_ROOT = Path(config["paths"]["legacy_root"])


def resolve(spec):
    """Resolve a cache:/reference:/legacy:/project: path specification."""
    prefix, separator, relative = spec.partition(":")
    roots = {
        "cache": CACHE_ROOT,
        "reference": REFERENCE_ROOT,
        "legacy": LEGACY_ROOT,
        "project": PROJECT_ROOT,
    }
    if separator and prefix in roots:
        return str((roots[prefix] / relative).resolve())
    return str((PROJECT_ROOT / spec).resolve())


# Pinned external resources.
POMBASE_CODING_DIR = Path(resolve(config["resources"]["pombase"]["gene_table"])).parent
POMBASE_GENE_TABLE = resolve(config["resources"]["pombase"]["gene_table"])
POMBASE_PEPTIDE = str(POMBASE_CODING_DIR / "peptide.fa.gz")
POMBASE_PEPTIDE_STATS = resolve(config["resources"]["pombase"]["peptide_stats"])
POMBASE_GFF3 = resolve(config["resources"]["pombase"]["gff3"])
FEATURES_GENE_TABLE = resolve(config["resources"]["pombase"]["features_gene_table"])
FEATURES_PEPTIDE_STATS = resolve(config["resources"]["pombase"]["features_peptide_stats"])
TED_DUMP = resolve(config["resources"]["ted"]["filtered_dump"])
ECOD_DUMP = resolve(config["resources"]["ecod"]["dump"])
UNIPROT_TRIANGULATION = resolve(config["resources"]["uniprot"]["triangulation"])
UNIPROT_RESOLUTION = resolve(config["resources"]["uniprot"]["resolution"])

# Numbered result paths, in pipeline order.
AFDB_RESULTS = f"{RESULTS}/01_afdb"
