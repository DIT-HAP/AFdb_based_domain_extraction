"""
AFdb domain extraction workflow.
================================

Root Snakefile: configuration roots, dataset declarations, stage includes, and
the default target. Rules live in ``workflow/rules/<stage>.smk``, one file per
pipeline stage; dataset input paths live in ``workflow/datasets/<dataset>.smk``.

Input
-----
- ``config/config.yaml`` and the dataset declarations.

Output
------
- ``results/<dataset>/segments.tsv`` and ``results/combined/segments.tsv``.

Usage
-----
    snakemake -n
    snakemake --cores 16 --use-conda
"""

from pathlib import Path

WORKFLOW_DIR = Path(workflow.basedir).resolve()
PROJECT_ROOT = WORKFLOW_DIR.parent
CONFIG_PATH = PROJECT_ROOT / "config" / "config.yaml"
RESULTS = PROJECT_ROOT / "results"
DATA = PROJECT_ROOT / "data"
RESOURCES = PROJECT_ROOT / "resources"
CLI = PROJECT_ROOT / "scripts" / "afdb_domains.py"
CORE_ENV = str(WORKFLOW_DIR / "envs" / "core.yaml")

configfile: str(CONFIG_PATH)

CACHE_ROOT = Path(config["paths"]["cache_root"])
REFERENCE_ROOT = Path(config["paths"]["reference_root"])
LEGACY_ROOT = Path(config["paths"]["legacy_root"])
RAW_ROOT = Path(config["paths"]["raw_root"])


def resolve(spec):
    """Resolve a cache:/reference:/legacy:/raw:/project: path specification."""
    prefix, separator, relative = spec.partition(":")
    roots = {
        "cache": CACHE_ROOT,
        "reference": REFERENCE_ROOT,
        "legacy": LEGACY_ROOT,
        "raw": RAW_ROOT,
        "project": PROJECT_ROOT,
    }
    if separator and prefix in roots:
        return str((roots[prefix] / relative).resolve())
    return str((PROJECT_ROOT / spec).resolve())


FEATURES_GENE_TABLE = resolve(config["resources"]["pombase"]["features_gene_table"])
FEATURES_PEPTIDE_STATS = resolve(config["resources"]["pombase"]["features_peptide_stats"])
POMBASE_GFF3 = resolve(config["resources"]["pombase"]["gff3"])
POMBASE_PEPTIDE_STATS = resolve(config["resources"]["pombase"]["peptide_stats"])
TED_DUMP = resolve(config["resources"]["ted"]["filtered_dump"])
ECOD_DUMP = resolve(config["resources"]["ecod"]["dump"])

DATASETS = {}
include: "datasets/AFDB_v4.smk"
include: "datasets/vDulab.smk"
include: "datasets/vDulab2.smk"
include: "datasets/AF3.smk"
include: "datasets/DY47073.smk"
include: "datasets/AFDB_20251107.smk"

ENABLED_DATASETS = sorted(name for name, entry in DATASETS.items() if entry["enabled"])


def subset_flag(entry):
    """Render the optional --protein-subset flag for a dataset."""
    subset = entry.get("protein_subset")
    return f"--protein-subset {subset}" if subset else ""


wildcard_constraints:
    dataset="(?!combined$)[A-Za-z0-9_.-]+",


include: "rules/pae.smk"
include: "rules/plddt.smk"
include: "rules/domains.smk"
include: "rules/external.smk"
include: "rules/unify.smk"
include: "rules/dna.smk"


rule all:
    input:
        expand(f"{RESULTS}/{{dataset}}/segments.tsv", dataset=ENABLED_DATASETS),
        f"{RESULTS}/combined/segments.tsv",
