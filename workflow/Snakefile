REGISTRY_TABLE = f"{REGISTRY_RESULTS}/01_gene_structure_registry.tsv"
REGISTRY_SUMMARY = f"{REGISTRY_RESULTS}/02_registry_summary.tsv"
REGISTRY_STATS = f"{REGISTRY_RESULTS}/03_registry_stats.tsv"
PAE_DOMAINS = f"{RESULTS}/05_domains"
