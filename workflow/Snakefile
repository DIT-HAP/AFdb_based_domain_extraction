ANNOTATED_TABLE = f"{RESULTS}/09_annotated_PAE_domain.tsv"
SEGMENTS_TABLE = f"{RESULTS}/10_segments.tsv"

CURATED_VERSION = "registry_2026-06-01"


def subset_flag(entry):
    """Render the optional --protein-subset flag for a dataset."""
    subset = entry.get("protein_subset")
    return f"--protein-subset {subset}" if subset else ""


wildcard_constraints:
    dataset="(?!combined$)[A-Za-z0-9_.-]+",

include: "rules/01_afdb.smk"
include: "rules/02_uniprot.smk"
include: "rules/03_compare.smk"
include: "rules/04_registry.smk"
include: "rules/05_curated.smk"
include: "rules/06_pae.smk"
include: "rules/07_plddt.smk"
include: "rules/08_domains.smk"
include: "rules/09_external.smk"
include: "rules/10_unify.smk"
include: "rules/11_dna.smk"


rule all:
    default_target: True
    input:
        f"{AFDB_RESULTS}/03_afdb_entries.tsv",
        REGISTRY_TABLE,
        REGISTRY_STATS,
        SEGMENTS_TABLE,
        expand(f"{RESULTS}/{{dataset}}/segments.tsv", dataset=ENABLED_DATASETS),
